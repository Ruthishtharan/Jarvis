{
  "name": "jarvis-desktop",
  "version": "1.0.0",
  "description": "JARVIS \u2014 voice assistant and its control brain",
  "main": "main-jarvis.js",
  "homepage": "./",
  "author": "Ruthish",
  "license": "MIT",
  "scripts": {
    "jarvis": "electron main-jarvis.js",
    "brain": "electron main-brain.js",
    "both": "concurrently \"npm run jarvis\" \"npm run brain\"",
    "build:jarvis": "electron-builder --config electron-builder-jarvis.yml",
    "build:brain": "electron-builder --config electron-builder-brain.yml",
    "build": "npm run build:jarvis && npm run build:brain"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.jarvis.ai",
    "productName": "Neutron",
    "files": [
      "build/**/*",
      "public/electron.js",
      "node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "JARVIS listens for your voice commands."
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
