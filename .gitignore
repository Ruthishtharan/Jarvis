# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Runtime data (logs, caches, memory, models, Chrome profile) ──────────────
# NOTE: data/chrome_profile is legacy (WhatsApp Web) and no longer used, but
# we gitignore it anyway in case Selenium gets re-enabled — it contains login
# cookies that must never be committed.
data/logs/
data/cache/
data/memory_store/
data/models/
data/chrome_profile/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual envs
venv/
.venv/
env/
.env-venv/

# ── OS / IDE ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Whisper model caches (can be tens of MB–GB) ──────────────────────────────
*.pt
*.bin
