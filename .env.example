# ─────────────────────────────────────────────────────────────────────────────
# Jarvis.ai — environment variables
# Copy this file to `.env` and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Groq (LLM provider for conversation + intent fallback)
# Get a free key at https://console.groq.com
GROQ_API_KEY=
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile  # retired by Groq 2026-09
# GROQ_FAST_MODEL=llama-3.1-8b-instant  # retired by Groq 2026-09

# Voice — wake word & transcription
JARVIS_WAKE_WORD=jarvis
TTS_VOICE=Samantha
TTS_RATE=160
STT_LANGUAGE=en-US

# Offline STT via openai-whisper (set to true to avoid Google STT rate limits)
USE_OFFLINE_STT=false
WHISPER_MODEL_SIZE=base   # tiny | base | small | medium

# Misc
USER_NAME=Boss
LOG_LEVEL=INFO
MAX_HISTORY=20
DEBUG=false

# ── Text-to-speech engine ────────────────────────────────────────────────────
# "say"        = macOS built-in. Instant, offline, robotic.
# "elevenlabs" = streaming neural TTS. Needs a key; falls back to `say` on any
#                failure, so it is safe to leave enabled.
TTS_ENGINE=elevenlabs

# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=s3TPKV1kjDlVtZbl4Ksh
# Flash v2.5: ~75ms inference, roughly half the credits of multilingual.
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── LLM fallback chain (optional) ────────────────────────────────────────────
# Only used when the primary provider (Groq) fails. Never touches the fast
# path, so responsiveness is unaffected. See ai/llm_fallback.py
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_TIMEOUT=12

# Tier 1 — FreeLLMAPI router (aggregates ~34 free provider tiers).
# Leave blank to skip this tier. Install: curl -fsSL https://freellmapi.co/install.sh | bash
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto

# Tier 2 — local Ollama. Always tried last; works with no network.
# On an 8 GB machine keep this small (llama3.2:3b / qwen2.5:3b).
# A 7B model will swap to disk and blow the timeout.
